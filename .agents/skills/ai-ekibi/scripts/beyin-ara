#!/usr/bin/env python3
"""beyin-ara "<konu>" [--limit N]: flugel-beyin vault'unda konuyu arar, okunur özet basar.

Önce beyin.py context (--no-sync) denenir; hata verirse (ör. salt okunur sandbox)
vault içinde grep ile yedek arama yapılır.
"""
import argparse, json, re, subprocess, sys

VAULT = "/home/gokalp/Documents/ai_workplace/flugel-beyin"
HARIC = ("_arsiv", ".git", "receipts")


def beyin_context(konu, limit):
    cmd = ["python3", f"{VAULT}/beyin.py", "--vault", VAULT, "--json",
           "context", "--no-sync", "--limit", str(limit), konu]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    return json.loads(r.stdout)["records"]


def baslik(metin):
    m = re.search(r"^#+\s*(.+)$", metin, re.M)
    return m.group(1).strip() if m else "(başlıksız)"


def yaz_kayit(k):
    metin = k.get("text") or ""
    print(f"## {k.get('source', '?')}\n{baslik(metin)}\n{' '.join(metin.split())[:400]}\n")


def grep_dosyalar(kelime, limit):
    cmd = ["grep", "-rIl", "-i", "--include=*.md", kelime, VAULT]
    cmd += [f"--exclude-dir={d}" for d in HARIC]
    return subprocess.run(cmd, capture_output=True, text=True).stdout.split()[:limit]


def eslesen_satirlar(yol, kelime, adet=2):
    cmd = ["grep", "-i", "-m", str(adet), kelime, yol]
    return subprocess.run(cmd, capture_output=True, text=True).stdout.strip().splitlines()


def yedek_arama(konu, limit):
    print("(yedek arama: beyin.py çalışmadı, vault'ta grep ile arandı)\n")
    kelime = max(konu.split(), key=len)  # en uzun kelime: en ayırt edici
    for yol in grep_dosyalar(kelime, limit):
        print(f"## {yol}")
        for satir in eslesen_satirlar(yol, kelime):
            print(f"  {satir.strip()[:200]}")
        print()


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("konu")
    ap.add_argument("--limit", type=int, default=5)
    a = ap.parse_args()
    try:
        kayitlar = beyin_context(a.konu, a.limit)
    except Exception:  # noqa: BLE001
        return yedek_arama(a.konu, a.limit)
    if not kayitlar:
        print("kayıt bulunamadı")
    for k in kayitlar:
        yaz_kayit(k)


if __name__ == "__main__":
    sys.exit(main())
