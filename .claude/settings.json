{
  "permissions": {
    "deny": [
      "Edit(/raw/**)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "SessionStart": [],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-wiki-edit.sh"
          }
        ]
      }
    ]
  }
}
